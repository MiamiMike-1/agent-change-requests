  "description": "Client side of the Agent Change Requests extension for @modelcontextprotocol/sdk: consent, a model-facing submission tool, redaction, the inbox, and requester confirmation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MiamiMike-1/agent-change-requests.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/MiamiMike-1/agent-change-requests/tree/main/packages/client",
  "type": "module",
  "main": "./dist/index.js",
