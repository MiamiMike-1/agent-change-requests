{
  "name": "@agent-change-requests/server",
  "version": "0.4.0",
  "description": "Server-side implementation of the Agent Change Requests extension: the changeRequests/* protocol methods as McpServer middleware, a SQLite store, request rules, lifecycle, principal-scoped inbox, status events, confirmations, scorecard, and MCP tools.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MiamiMike-1/agent-change-requests.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/MiamiMike-1/agent-change-requests/tree/main/packages/server",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js"
    },
    "./endpoint": {
      "types": "./dist/endpoint.d.ts",
      "import": "./dist/endpoint.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    },
    "./testing": {
      "types": "./dist/testing/conformance.d.ts",
      "import": "./dist/testing/conformance.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.25 || ^4.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
